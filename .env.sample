# Application
APP_NAME=Mira AI
APP_VERSION=0.1.0
API_BASE_URL: str = "http://localhost:8000"
DEBUG=false

# Logging
LOG_LEVEL=INFO

# Database (PostgreSQL with asyncpg)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/mira_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672/

# Storage 
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=mira-uploads
S3_REGION=us-east-1

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Security
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
REQUIRE_EMAIL_VERIFICATION=true

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_TLS=true
SMTP_FROM_EMAIL=noreply@mira.ai
SMTP_FROM_NAME=Mira AI

# Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_API_KEY=your_google_api_key_here

# LiveKit (Voice Sessions)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
ENABLE_AGENT_DISPATCH=true

# LiveKit SIP (Phone Calls)
LIVEKIT_SIP_ENABLED=false
LIVEKIT_SIP_URI=sip:your-trunk@livekit.cloud

# Twilio (SIP / Voice)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_SIP_DOMAIN=your-domain.sip.twilio.com
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_SIP_TRUNK_ID=ST_xxxxxxxxxxxxxxx